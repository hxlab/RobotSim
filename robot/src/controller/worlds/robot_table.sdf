<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="soft_world">
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>


    <model name="rgbd_camera">
        <static>true</static>
        <pose>1.0 0.0 1.5 0 0.3 3.14159</pose>

        <link name="rgbd_camera_frame">

            <visual name="rgbd_camera_visual">
              <origin xyz="0 0 0" rpy="0 0 0"/>
              <geometry>
                <mesh filename="package://controller/worlds/d435.dae"/>
              </geometry>
              <material name="white">
                <color rgba="0.9 0.9 0.9 1.0"/>
              </material>
            </visual>

            <sensor name="rgbd_camera" type="rgbd_camera">
              <camera name="rgbd_camera_frame">
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                  <width>1280</width>
                  <height>720</height>
                  <format>R8G8B8</format>
                </image>
                <clip>
                  <near>0.01</near>
                  <far>300</far>
                </clip>
                <depth_camera>
                  <clip>
                    <near>0.1</near>
                    <far>10</far>
                  </clip>
                </depth_camera>
                <noise>
                  <type>gaussian</type>
                  <mean>0</mean>
                  <stddev>0.003</stddev>
                </noise>
              </camera>
              <always_on>1</always_on>
              <update_rate>10</update_rate>
              <visualize>0</visualize>
              <topic>depth_camera</topic>
            </sensor>
        </link>
    </model>
    
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="table1">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>20.0</mass>
          <inertia>
            <ixx>1.5</ixx><iyy>2.0</iyy><izz>2.0</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>

        <collision name="table_collision">
        <pose>0 0 0.99 0 0 0</pose>
        <geometry>
          <box><size>1.5 1.0 0.02</size></box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>     <!-- primary friction -->
              <mu2>100.0</mu2>   <!-- secondary direction -->
            </ode>
          </friction>

          <contact>
            <ode>
              <kp>1e5</kp>        <!-- stiffness (yours is WAY too low) -->
              <kd>10.0</kd>       <!-- damping -->
            </ode>
          </contact>
        </surface>
      </collision>

        <visual name="table_visual">
          <pose>0 0 0.99 0 0 0</pose>
          <geometry><box><size>1.5 1.0 0.02</size></box></geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>

        <collision name="leg_fl_col">
          <pose>0.65 0.45 0.49 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.98</size></box></geometry>

        </collision>
        <visual name="leg_fl_vis">
          <pose>0.65 0.45 0.49 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.98</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>

        <collision name="leg_fr_col">
          <pose>0.65 -0.45 0.49 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.98</size></box></geometry>

        </collision>
        <visual name="leg_fr_vis">
          <pose>0.65 -0.45 0.49 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.98</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>

        <collision name="leg_bl_col">
          <pose>-0.65 0.45 0.49 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.98</size></box></geometry>

        </collision>
        <visual name="leg_bl_vis">
          <pose>-0.65 0.45 0.49 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.98</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>

        <collision name="leg_br_col">
          <pose>-0.65 -0.45 0.49 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.98</size></box></geometry>

        </collision>
        <visual name="leg_br_vis">
          <pose>-0.65 -0.45 0.49 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.98</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Cube -->
    <model name="cube">
      <pose>0.25 -0.25 1.025 0 0 0</pose>

      <link name="link">

        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00002</ixx>
            <iyy>0.00002</iyy>
            <izz>0.00002</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- Rectangular Prism -->
    <model name="rectangular_prism">
      <pose>0.25 0.0 1.0375 0 0 0</pose>

      <link name="link">

        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00025</ixx>
            <iyy>0.000125</iyy>
            <izz>0.0003</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.125 0.05 0.075</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.125 0.05 0.075</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.8 0.1 1</ambient>
            <diffuse>0.1 0.8 0.1 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- Cylinder -->
    <model name="cylinder">
      <pose>0.25 0.25 1.075 0 0 0</pose>

      <link name="link">

        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.00015</ixx>
            <iyy>0.00015</iyy>
            <izz>0.000075</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1</ambient>
            <diffuse>0.1 0.1 0.8 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
  </world>
</sdf>